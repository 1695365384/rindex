# ── Rust build ──
**/target/
**/tmp_test/

# ── Model cache (downloaded, not tracked) ──
**/models/

# ── Distilled model (tracked via LFS, used by installers) ──
!rindex-models/

# ── Old BERT model dir ──
model/

# ── Release packages ──
rindex-v*/
*.zip
*.tar.gz

# ── Python ──
__pycache__/
*.pyc

# ── IDE / OS ──
.vscode/
.DS_Store
*.log

# ── Test artifacts ──
test_*.json
